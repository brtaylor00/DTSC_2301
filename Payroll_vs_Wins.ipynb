   "source": [
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "# Make a copy and convert payroll to millions\n",
    "plot_df = df.copy()\n",
    "plot_df[\"Payroll_Millions\"] = plot_df[\"Payroll\"] / 1_000_000\n",
    "\n",
    "# Histogram\n",
    "sns.histplot(\n",
    "    data=plot_df,\n",
    "    x=\"Payroll_Millions\",\n",
    "    bins=10\n",
    ")\n",
    "\n",
    "# Create payroll groups\n",
    "plot_df[\"Payroll_Group\"] = pd.cut(\n",
    "    plot_df[\"Payroll_Millions\"],\n",
    "    bins=10\n",
    ")\n",
    "\n",
    "# Calculate average wins for each payroll group\n",
    "avg_wins = plot_df.groupby(\n",
    "    \"Payroll_Group\",\n",
    "    observed=True\n",
    ")[\"Wins\"].mean()\n",
    "\n",
    "# Get midpoint of each payroll group\n",
    "midpoints = [interval.mid for interval in avg_wins.index]\n",
    "\n",
    "# Add average-wins line using a second y-axis\n",
    "ax2 = plt.gca().twinx()\n",
    "\n",
    "ax2.plot(\n",
    "    midpoints,\n",
    "    avg_wins.values,\n",
    "    marker=\"o\",\n",
    "    linewidth=1.5,\n",
    "    color=\"red\"\n",
    ")\n",
    "\n",
    "# Labels\n",
    "plt.title(\"MLB Payroll Distribution and Average Wins by Payroll Level, 2011–2024\")\n",
    "plt.xlabel(\"Team Payroll (Millions of Dollars)\")\n",
    "plt.ylabel(\"Number of Team-Seasons\")\n",
    "ax2.set_ylabel(\"Average Regular-Season Wins\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
